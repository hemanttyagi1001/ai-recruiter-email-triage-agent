# Copy to .env and fill in values. .env is gitignored.

DATABASE_URL=postgresql+psycopg://triage:triage_local@localhost:5432/triage
TEST_DATABASE_URL=postgresql+psycopg://triage:triage_local@localhost:5432/triage_test

# Gmail OAuth
# credentials.json is issued by Google Cloud Console (OAuth 2.0 Client ID,
# "Desktop app" type). token.json is created on first auth by the install flow.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_LABEL=INBOX
GMAIL_MAX_MESSAGES=200

# Azure OpenAI — single cheap deployment for both classify and extract.
# Name the deployment after its model (e.g. "gpt-5-mini"): app/llm/pricing.py
# bills by the model name Azure echoes back, and an unrecognised name falls
# back to default rates with only a log warning.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# Reasoning models (GPT-5 family) accept only their default temperature and
# HTTP 400 on anything else; GPT-4-class models accept the full range.
# Set true only for a deployment that actually supports it.
AZURE_OPENAI_SUPPORTS_TEMPERATURE=false

# Phase 4 — separate Azure deployment for embeddings. Must be a
# text-embedding-3-small deployment (1536 dims). If DEDUP_ENABLED=false
# this can be left unset.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name
DEDUP_ENABLED=true

API_HOST=127.0.0.1
API_PORT=8000

# --- Phase 6: containerised continuous run ---
# The same database as DATABASE_URL, addressed from inside a container, where
# `localhost` refers to the container rather than the host. Only docker-compose
# reads this; the CLI, pytest and alembic keep using DATABASE_URL.
DOCKER_DATABASE_URL=postgresql+psycopg://user:pw@host.docker.internal:5432/triage

# off | dry_run | draft | on   — see app/config.py for the full semantics.
#   off     - every draft waits for human approval at /pending
#   dry_run - walk the whole autonomous path, log what would be sent, send
#             nothing.
#   draft   - create the reply in Gmail Drafts with no approval step. Nothing
#             is sent; you review and press send. The recommended soak setting:
#             identical to `on` except for the final API call, so time spent
#             here is real evidence about what `on` would do.
#   on      - actually email recruiters with no human in the loop. Irreversible
#             per message; fill in candidate.toml before arming this.
# template | llm  — who writes the reply body.
#   template - str.format over committed .txt files. Cannot hallucinate and
#              cannot be steered by the email it answers, but cannot answer a
#              question either.
#   llm      - a tool-free model writes the body, so the reply responds to
#              what the recruiter actually asked.
# GOTCHA: an llm-written body is NEVER auto-sent, whatever AUTO_SEND_MODE
# says — it always lands in Gmail Drafts for a human. See D56.
DRAFT_MODE=llm

AUTO_SEND_MODE=draft

# Minutes between Gmail polls when running `python -m app.cli.watch`.
POLL_INTERVAL_MINUTES=15

# Resume attached to replies ONLY when the recruiter asks for one — see
# app/rules/resume_request.py for what counts as asking. Leave unset for no
# attachment ever. The filename on disk is what the recruiter sees.
RESUME_PATH=your_resume.pdf

LOG_DIR=logs
